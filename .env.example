# Configuración de Entorno - LesGo ERP Logística (Neon PostgreSQL - Esquema logistica)
# IMPORTANTE: Copiar a .env y reemplazar con las credenciales reales entregadas por el profesor. Nunca subir .env al repositorio.
PORT=3001
CLIENT_URL=http://localhost:5173
DATABASE_URL="postgresql://<USUARIO>:<PASSWORD_URL_ENCODED>@<HOST_NEON>:5432/si2_22026?schema=logistica&sslmode=require"
NODE_ENV=development

# --- Integración con Inventario (API REST, repo PA1IN/Proyecto-SI-2) ---
# URL base con el prefijo /api/v1, sin "/" al final. Vacía = cliente SIMULADO (no se llama a Inventario).
#   Inventario en tu máquina con npm run dev:        http://localhost:3000/api/v1
#   Inventario en tu máquina y Logística en Docker:  http://host.docker.internal:3000/api/v1
INVENTARIO_API_URL=
# API key del módulo logistica que entrega Inventario. Se envía como "Authorization: Bearer <clave>".
INVENTARIO_API_KEY=
# Tiempo máximo de espera por llamada (ms)
INVENTARIO_TIMEOUT_MS=8000

# --- Integración con RRHH (repo Pabluntt/Lesgo-RRHH) ---
# bd = lee el esquema rrhh de la BD del curso (solo SELECT) | simulado = empleados de prueba en memoria (no toca rrhh)
# Vacío o un valor no válido = simulado.
RRHH_MODO=simulado
# Mismo secreto que usa el backend de RRHH (acordarlo con el grupo). Vacío = el servidor no arranca en modo jwt.
JWT_SECRET=
JWT_EXPIRES_IN=8h
# jwt = exige Authorization: Bearer | simulado = acepta cabeceras x-user-* (solo desarrollo y tests)
AUTH_MODO=simulado
# URL del portal de RRHH, para el botón "Volver al portal"
RRHH_PORTAL_URL=http://localhost:5173

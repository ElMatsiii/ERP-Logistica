# Configuración del cliente de Logística (Vite). Copiar a client/.env y completar. Nunca subir client/.env.
# Solo las variables con prefijo VITE_ llegan al navegador: no poner secretos aquí.

# URL del portal del ERP (RRHH). Allí se inicia sesión; el portal redirige a Logística con #token=<jwt>.
# Se usa en "Ir al portal del ERP", "Volver al portal" y al cerrar sesión. Vacía = sin enlace al portal.
VITE_RRHH_PORTAL_URL=

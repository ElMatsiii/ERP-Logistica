// Prisma schema for LesGo ERP - Módulo de Logística y Transporte
// Sprint 2 - MVP (Esquema: logistica)

generator client {
  provider = "prisma-client-js"
}

generator serverClient {
  provider = "prisma-client-js"
  output   = "../server/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["logistica"]
}

enum EstadoOT {
  PENDIENTE
  EN_PROCESO
  PARCIAL
  CERRADO

  @@schema("logistica")
}

model log_transportista {
  id                          Int             @id @default(autoincrement())
  rut                         String          @unique
  nombre                      String
  contacto_email              String
  contacto_telefono           String
  factor_volumetrico_default  Int             @default(5000)
  activo                      Boolean         @default(true)

  servicios                   log_servicio[]
  guias                       log_guia_despacho[]

  @@map("log_transportista")
  @@schema("logistica")
}

model log_servicio {
  id                          Int             @id @default(autoincrement())
  transportista_id            Int
  nombre                      String
  dias_transito_comprometidos Int
  activo                      Boolean         @default(true)

  transportista               log_transportista @relation(fields: [transportista_id], references: [id], onDelete: Cascade)
  coberturas                  log_cobertura[]
  tarifas                     log_tarifa[]
  guias                       log_guia_despacho[]

  @@map("log_servicio")
  @@schema("logistica")
}

model log_region {
  id      Int          @id @default(autoincrement())
  nombre  String

  comunas log_comuna[]

  @@map("log_region")
  @@schema("logistica")
}

model log_comuna {
  id          Int             @id @default(autoincrement())
  region_id   Int
  nombre      String

  region      log_region      @relation(fields: [region_id], references: [id], onDelete: Cascade)
  coberturas  log_cobertura[]
  tarifas     log_tarifa[]
  direcciones log_direccion[]

  @@map("log_comuna")
  @@schema("logistica")
}

model log_cobertura {
  id             Int          @id @default(autoincrement())
  servicio_id    Int
  comuna_id      Int
  vigencia_desde DateTime
  vigencia_hasta DateTime
  vigente        Boolean      @default(true)

  servicio       log_servicio @relation(fields: [servicio_id], references: [id], onDelete: Cascade)
  comuna         log_comuna   @relation(fields: [comuna_id], references: [id], onDelete: Cascade)

  @@map("log_cobertura")
  @@schema("logistica")
}

model log_tarifa {
  id                  Int          @id @default(autoincrement())
  servicio_id         Int
  comuna_id           Int
  peso_desde_kg       Decimal      @db.Decimal(10, 2)
  peso_hasta_kg       Decimal      @db.Decimal(10, 2)
  precio_base         Decimal      @db.Decimal(10, 2)
  precio_kg_adicional Decimal      @db.Decimal(10, 2)
  vigencia_desde      DateTime
  vigencia_hasta      DateTime

  servicio            log_servicio @relation(fields: [servicio_id], references: [id], onDelete: Cascade)
  comuna              log_comuna   @relation(fields: [comuna_id], references: [id], onDelete: Cascade)

  @@map("log_tarifa")
  @@schema("logistica")
}

model log_direccion {
  id             Int                @id @default(autoincrement())
  cliente_id     Int
  cliente_nombre String?
  cliente_rut    String?
  comuna_id      Int
  calle          String
  numero         String
  depto          String?
  referencia     String?
  activa         Boolean            @default(true)

  comuna         log_comuna         @relation(fields: [comuna_id], references: [id], onDelete: Cascade)
  guias          log_guia_despacho[]
  ots            log_ot_picking[]

  @@map("log_direccion")
  @@schema("logistica")
}

model log_ot_picking {
  id              String                  @id // ej: "OT-4091"
  id_pedido       String                  // ej: "PED-10294"
  id_operador     Int
  nombre_operador String
  estado          EstadoOT
  fecha_creacion  DateTime                @default(now())

  cliente_id      Int?
  cliente_nombre  String?
  cliente_rut     String?
  direccion_id    Int?
  direccion       log_direccion?          @relation(fields: [direccion_id], references: [id])

  detalles        log_ot_picking_detalle[]
  guias           log_guia_despacho[]

  @@map("log_ot_picking")
  @@schema("logistica")
}

model log_ot_picking_detalle {
  id               Int            @id @default(autoincrement())
  ot_id            String
  id_producto      Int
  sku              String
  nombre_producto  String
  cant_solicitada  Int
  cant_recolectada Int
  peso_unitario_kg Decimal?       @db.Decimal(10, 2)
  largo_cm         Decimal?       @db.Decimal(10, 2)
  alto_cm          Decimal?       @db.Decimal(10, 2)
  ancho_cm         Decimal?       @db.Decimal(10, 2)

  ot               log_ot_picking      @relation(fields: [ot_id], references: [id], onDelete: Cascade)
  bulto_detalles   log_bulto_detalle[]

  @@map("log_ot_picking_detalle")
  @@schema("logistica")
}

model log_guia_despacho {
  id                          String                @id // ej: "GD-52341"
  ot_id                       String
  transportista_id            Int
  servicio_id                 Int
  direccion_id                Int
  num_seguimiento             String                @unique
  factor_volumetrico_aplicado Int
  peso_real_total_kg          Decimal               @db.Decimal(10, 2)
  peso_volumetrico_total_kg   Decimal               @db.Decimal(10, 2)
  costo_envio                 Decimal               @db.Decimal(10, 2)
  estado_actual               String
  fecha_emision               DateTime              @default(now())

  ot                          log_ot_picking        @relation(fields: [ot_id], references: [id])
  transportista               log_transportista     @relation(fields: [transportista_id], references: [id])
  servicio                    log_servicio          @relation(fields: [servicio_id], references: [id])
  direccion                   log_direccion         @relation(fields: [direccion_id], references: [id])
  bultos                      log_bulto[]
  eventos                     log_evento_tracking[]
  incidencias                 log_incidencia[]

  @@map("log_guia_despacho")
  @@schema("logistica")
}

model log_bulto {
  id                  Int                 @id @default(autoincrement())
  guia_id             String
  largo_cm            Decimal             @db.Decimal(10, 2)
  alto_cm             Decimal             @db.Decimal(10, 2)
  ancho_cm            Decimal             @db.Decimal(10, 2)
  peso_real_kg        Decimal             @db.Decimal(10, 2)
  peso_volumetrico_kg Decimal             @db.Decimal(10, 2)

  guia                log_guia_despacho   @relation(fields: [guia_id], references: [id], onDelete: Cascade)
  detalles            log_bulto_detalle[]

  @@map("log_bulto")
  @@schema("logistica")
}

model log_evento_tracking {
  id                 Int               @id @default(autoincrement())
  guia_id            String
  estado             String
  fecha_hora         DateTime          @default(now())
  usuario_responsable String
  observacion        String

  guia               log_guia_despacho @relation(fields: [guia_id], references: [id], onDelete: Cascade)

  @@map("log_evento_tracking")
  @@schema("logistica")
}

model inv_mov {
  id                Int      @id @default(autoincrement()) @map("id_mov")
  id_producto       Int
  tipo              String   @default("SALIDA")
  cantidad          Int
  referencia_origen String
  fecha             DateTime @default(now())
  id_usuario        Int?

  @@map("test_log_inv_mov")
  @@schema("logistica")
}

// ============================================================================
// TABLAS ADICIONALES DEL MODELO LÓGICO DEL INFORME (Completando las 17 log_*)
// ============================================================================

model log_estado_envio {
  id          Int     @id @default(autoincrement())
  codigo      String  @unique
  nombre      String
  orden_flujo Int
  es_terminal Boolean @default(false)

  @@map("log_estado_envio")
  @@schema("logistica")
}

model log_bulto_detalle {
  id            Int                    @id @default(autoincrement())
  bulto_id      Int
  ot_detalle_id Int
  cantidad      Int

  bulto         log_bulto              @relation(fields: [bulto_id], references: [id], onDelete: Cascade)
  ot_detalle    log_ot_picking_detalle @relation(fields: [ot_detalle_id], references: [id], onDelete: Cascade)

  @@map("log_bulto_detalle")
  @@schema("logistica")
}

model log_incidencia {
  id                Int               @id @default(autoincrement())
  guia_id           String
  tipo              String
  fecha_registro    DateTime          @default(now())
  descripcion       String
  id_caso_postventa Int?
  resuelta          Boolean           @default(false)

  guia              log_guia_despacho @relation(fields: [guia_id], references: [id], onDelete: Cascade)

  @@map("log_incidencia")
  @@schema("logistica")
}

model log_recepcion {
  id                   Int                     @id @default(autoincrement())
  id_oc                Int
  id_empleado_receptor Int
  fecha_recepcion      DateTime                @default(now())
  estado               String
  observacion          String?

  detalles             log_recepcion_detalle[]

  @@map("log_recepcion")
  @@schema("logistica")
}

model log_recepcion_detalle {
  id                Int           @id @default(autoincrement())
  recepcion_id      Int
  id_producto       Int
  cantidad_esperada Int
  cantidad_recibida Int
  cantidad_danada   Int           @default(0)
  motivo_dano       String?

  recepcion         log_recepcion @relation(fields: [recepcion_id], references: [id], onDelete: Cascade)

  @@map("log_recepcion_detalle")
  @@schema("logistica")
}

// ============================================================================
// TABLAS DE PRUEBA QUE SIMULAN OTROS MÓDULOS (Sección 9.2 - test_log_*)
// ============================================================================

model VentasCliente {
  id_cliente Int            @id @default(autoincrement())
  nombre     String
  rut        String         @unique
  email      String

  pedidos    VentasPedido[]

  @@map("test_log_ventas_cliente")
  @@schema("logistica")
}

model VentasPedido {
  id_pedido  Int                   @id @default(autoincrement())
  id_cliente Int
  numero     String                @unique
  fecha      DateTime              @default(now())
  estado     String

  cliente    VentasCliente         @relation(fields: [id_cliente], references: [id_cliente], onDelete: Cascade)
  detalles   VentasPedidoDetalle[]

  @@map("test_log_ventas_pedido")
  @@schema("logistica")
}

model VentasPedidoDetalle {
  id          Int          @id @default(autoincrement())
  id_pedido   Int
  id_producto Int
  cantidad    Int

  pedido      VentasPedido @relation(fields: [id_pedido], references: [id_pedido], onDelete: Cascade)

  @@map("test_log_ventas_pedido_detalle")
  @@schema("logistica")
}

model InvProducto {
  id_producto      Int      @id
  sku              String   @unique
  nombre           String
  peso_unitario_kg Decimal? @db.Decimal(10, 2)
  largo_cm         Decimal? @db.Decimal(10, 2)
  alto_cm          Decimal? @db.Decimal(10, 2)
  ancho_cm         Decimal? @db.Decimal(10, 2)

  @@map("test_log_inv_producto")
  @@schema("logistica")
}

model RrhhEmpleado {
  id_empleado Int           @id @default(autoincrement())
  nombre      String
  cargo       String

  usuarios    RrhhUsuario[]

  @@map("test_log_rrhh_empleado")
  @@schema("logistica")
}

model RrhhRol {
  id_rol   Int           @id @default(autoincrement())
  nombre   String        @unique

  usuarios RrhhUsuario[]

  @@map("test_log_rrhh_rol")
  @@schema("logistica")
}

model RrhhUsuario {
  id_usuario    Int          @id @default(autoincrement())
  id_empleado   Int
  id_rol        Int
  username      String       @unique
  password_hash String
  activo        Boolean      @default(true)

  empleado      RrhhEmpleado @relation(fields: [id_empleado], references: [id_empleado], onDelete: Cascade)
  rol           RrhhRol      @relation(fields: [id_rol], references: [id_rol], onDelete: Cascade)

  @@map("test_log_rrhh_usuario")
  @@schema("logistica")
}

model ComprasOc {
  id_oc     Int                @id @default(autoincrement())
  proveedor String
  fecha     DateTime           @default(now())
  estado    String

  detalles  ComprasOcDetalle[]

  @@map("test_log_compras_oc")
  @@schema("logistica")
}

model ComprasOcDetalle {
  id                Int       @id @default(autoincrement())
  id_oc             Int
  id_producto       Int
  cantidad_esperada Int

  oc                ComprasOc @relation(fields: [id_oc], references: [id_oc], onDelete: Cascade)

  @@map("test_log_compras_oc_detalle")
  @@schema("logistica")
}
